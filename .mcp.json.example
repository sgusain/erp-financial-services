{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "erp-postgres-readonly": {
      "command": "REPLACE_WITH_POSTGRES_MCP_SERVER_COMMAND",
      "args": ["REPLACE_WITH_ARGS", "postgresql://ai_readonly:${AI_READONLY_PASSWORD}@localhost:5432/transactiondb"]
    },
    "erp-ai-assistant": {
      "type": "http",
      "url": "http://localhost:8086/mcp",
      "headers": {
        "Authorization": "Bearer ${ERP_MCP_TOKEN}"
      }
    }
  }
}
